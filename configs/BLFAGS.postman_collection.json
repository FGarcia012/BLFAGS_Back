{
  "info": {
    "name": "BLFAGS — contrato seguro",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3020/BLFAGS/v1"
