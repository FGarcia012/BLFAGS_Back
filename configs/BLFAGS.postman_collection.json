  "item": [
    {
      "name": "Crear una cuenta USER y enviar una sola bienvenida",
      "request": {
        "method": "POST",
        "auth": {
          "type": "noauth"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "register"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Iniciar sesión sin revelar si existe una cuenta",
      "request": {
        "method": "POST",
        "auth": {
          "type": "noauth"
