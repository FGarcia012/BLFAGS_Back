  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "RegisterInput": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_]{3,20}$"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128
          }
        },
        "required": [
          "username",
          "email",
          "password"
        ]
      },
      "LoginInput": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "maxLength": 128
          }
        }
      },
      "PublicationInput": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 200
          },
          "description": {
            "type": "string",
            "maxLength": 1000
          },
          "visibility": {
            "type": "string",
            "enum": [
              "public",
              "private"
            ]
          },
          "media": {
            "type": "string",
            "format": "binary"
          }
        }
      },
      "CommentInput": {
        "type": "object",
        "properties": {
          "publication": {
            "type": "string"
          },
          "text": {
            "type": "string",
            "maxLength": 500
          },
          "media": {
            "type": "string",
            "format": "binary"
          }
        }
      },
      "ReactionInput": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "like",
              "love",
              "laugh",
              "sad",
              "angry"
            ]
          }
        }
      },
      "UserInput": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          }
        }
      },
      "PasswordInput": {
        "type": "object",
        "properties": {
          "currentPassword": {
            "type": "string"
          },
          "newPassword": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128
          }
        }
      },
      "FileInput": {
        "type": "object",
        "properties": {
          "profilePicture": {
            "type": "string",
            "format": "binary"
          }
        }
      },
      "Counts": {
        "type": "object",
        "properties": {
          "like": {
            "type": "integer",
            "minimum": 0
          },
          "love": {
            "type": "integer",
            "minimum": 0
          },
          "laugh": {
            "type": "integer",
            "minimum": 0
          },
          "sad": {
            "type": "integer",
            "minimum": 0
          },
          "angry": {
            "type": "integer",
            "minimum": 0
          },
          "total": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "Feed": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "publications": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "pid": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "isMine": {
                  "type": "boolean"
                },
                "commentCount": {
                  "type": "integer"
                },
                "reactionCount": {
                  "$ref": "#/components/schemas/Counts"
                },
                "userReaction": {
                  "type": "string",
                  "nullable": true
                }
              }
            }
          },
          "nextCursor": {
            "type": "string",
            "nullable": true
          },
          "hasMore": {
            "type": "boolean"
          }
        }
      }
    }
  }
}